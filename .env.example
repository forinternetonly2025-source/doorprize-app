# Salin file ini menjadi ".env" lalu isi nilainya

# ID spreadsheet Google Sheets (ambil dari URL sheet):
# https://docs.google.com/spreadsheets/d/INI_SPREADSHEET_ID/edit
SPREADSHEET_ID=

# Path ke file JSON key service account (lihat README.md untuk cara membuatnya)
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# Port lokal untuk menjalankan aplikasi
PORT=3000

# Nama sheet & kolom (default sesuai spesifikasi, ubah jika berbeda)
PUTAR_SHEET_NAME=PUTAR
DATA_SHEET_NAME=DATA
MENANG_SHEET_NAME=MENANG

# Jumlah doorprize yang diundi per sesi
PRIZES_PER_SESSION=10
